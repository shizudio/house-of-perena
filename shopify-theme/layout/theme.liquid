<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }} — House of Perena</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet">
  {{ content_for_header }}
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
</head>
<body>

<!-- NAV -->
<nav id="nav">
  <div class="nav-inner">
    <div class="nav-brand">
      <img src="{{ 'logo.svg' | asset_url }}" alt="House of Perena">
      <span class="nav-wordmark">House of Perena</span>
    </div>
    <div class="nav-right">
      <button class="cart-btn" id="cart-toggle" aria-label="Cart" type="button">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path class="cart-icon-line" d="M2 2h2.5l1.8 9h10.4l1.5-6H7" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
          <circle class="cart-icon-line" cx="9.5" cy="18.5" r="1" stroke-width="1"/>
          <circle class="cart-icon-line" cx="16.5" cy="18.5" r="1" stroke-width="1"/>
        </svg>
        <span class="cart-badge" id="cart-badge">{{ cart.item_count }}</span>
      </button>
      <button class="hamburger" id="hbg" aria-label="Menu" type="button">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="nav-drawer" id="drawer">
    <a class="drawer-item" href="{{ routes.collections_url }}">Shop</a>
    <a class="drawer-item" href="#">Lookbook</a>
    <a class="drawer-item" href="/pages/our-story">Our Story</a>
    <a class="drawer-item" href="{{ routes.contact_url }}">Contact</a>
  </div>
</nav>

{{ content_for_layout }}

<!-- CART OVERLAY + DRAWER -->
<div class="cart-overlay" id="cart-overlay"></div>
<aside id="cart-drawer" aria-label="Shopping cart">
  <div class="cart-head">
    <h3>Your Cart</h3>
    <button class="cart-close" id="cart-close" type="button" aria-label="Close cart">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
        <line x1="2" y1="2" x2="16" y2="16" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
        <line x1="16" y1="2" x2="2" y2="16" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
  <div class="cart-items" id="cart-items">
    <p class="cart-empty">Your cart is empty.</p>
  </div>
  <div class="cart-foot" id="cart-foot" style="display:none">
    <div class="cart-total-row">
      <span class="cart-total-label">Total</span>
      <span class="cart-total-val" id="cart-total">{{ cart.total_price | money }}</span>
    </div>
    <a class="btn-checkout" href="/cart">Proceed to Checkout</a>
  </div>
</aside>

<!-- FOOTER -->
<footer>
  <div class="footer-brand">
    <img src="{{ 'logo.svg' | asset_url }}" alt="House of Perena">
    <span class="footer-logo">House of Perena · 岩花</span>
  </div>
  <nav class="footer-links">
    <a href="https://www.instagram.com/houseofperena" target="_blank" rel="noopener">Instagram</a>
    <a href="/pages/sizing-guide">Sizing Guide</a>
    <a href="/pages/shipping">Shipping</a>
    <a href="{{ routes.contact_url }}">Contact</a>
    <a href="{{ routes.privacy_policy_url }}">Privacy</a>
  </nav>
</footer>

<script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
